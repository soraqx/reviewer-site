{
  "name": "engineering-math-field-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run content:compile",
    "predev:vercel": "npm run content:compile",
    "dev": "vite",
    "dev:vercel": "vercel dev",
    "dev:convex": "convex dev",
    "content:compile": "node scripts/compile-content-pack.js && node scripts/compile-formula-catalogue.js",
    "validate:data": "npm run content:compile && node scripts/validate-data.js",
    "test:problems": "node --test scripts/problem-engine.test.js",
    "test": "node --test scripts/problem-engine.test.js scripts/api-client.test.js scripts/api-routes.test.js scripts/course-navigation.test.js scripts/quiz-session.test.js scripts/quiz-progress.test.js",
    "build": "npm run validate:data && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "convex": "^1.51.0",
    "marked": "^18.2.1",
    "sanitize-html": "^2.18.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
